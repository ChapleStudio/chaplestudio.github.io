---
/* Üç derinlikte ağaç gövdeleri ve önde eğrelti otları. */
const tohum = (n: number) => { const s = Math.sin(n * 91.7) * 43758.5; return s - Math.floor(s); };
const govdeler = [
  { renk: '#1f4038', adet: 11, en: 22, kok: 660 },
  { renk: '#173328', adet: 8, en: 40, kok: 720 },
  { renk: '#0f2419', adet: 5, en: 70, kok: 800 },
].map((k, d) => ({ renk: k.renk, yol: Array.from({ length: k.adet }, (_, i) => {
  const x = ((i + tohum(i + d * 20) * 0.8) / k.adet) * 1440, e = k.en * (0.7 + tohum(i + d * 7) * 0.6), eg = (tohum(i + d * 3) - 0.5) * 70;
  return `M${x} -10C${x + eg} 250 ${x - eg * 0.4} 480 ${x - e * 0.5} ${k.kok}L${x - e * 1.5} 900H${x + e * 2.5}L${x + e * 1.4} ${k.kok}C${x + e - eg * 0.3} 480 ${x + e + eg} 250 ${x + e} -10Z`;
}).join('') }));
const egrelti = Array.from({ length: 26 }, (_, i) => { const x = i * 58 + tohum(i) * 40, b = 70 + tohum(i + 50) * 110, y = (tohum(i + 9) - 0.5) * 120; return `M${x} 900Q${x + y * 0.3} ${900 - b * 0.7} ${x + y} ${900 - b}Q${x + y * 0.3 + 16} ${900 - b * 0.6} ${x + 18} 900Z`; }).join('');
---
<svg class="orman-sus" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
  {govdeler.map((g) => <path d={g.yol} fill={g.renk} />)}
  <path d={egrelti} fill="#0b1a12" />
</svg>

---
import { Image } from 'astro:assets';
import Ikon from './Ikon.astro';
import RowlSus from '../temalar/rowl/Sus.astro';
import PeriSus from '../temalar/peri/Sus.astro';
import type { Kayit } from '../kutuphane/kayit';
interface Props { kayit: Kayit }
const { kayit } = Astro.props;
const arka = kayit.tur === 'is' ? kayit.veri.arka : undefined;
---
<header class="oda-giris">
  <canvas class="oda-sahne" data-sahne={kayit.sahne ?? ''} data-kayit={kayit.id} aria-hidden="true"></canvas>
  {arka && <Image class="oda-arka" src={arka} alt="" widths={[800, 1280]} sizes="100vw" loading="eager" />}
  <div class="oda-sus">
    {kayit.tema === 'rowl' && <RowlSus />}
    {kayit.tema === 'peri' && <PeriSus />}
  </div>
  <div class="oda-ust">
    <nav class="kapsul" aria-label="Yol">
      <a href={`/#${kayit.bolum.id}/${kayit.id}`} data-cik><Ikon ad="agac" boy={18} />Köklere dön</a>
      <a href={`/#${kayit.bolum.id}-${kayit.dal.id}`} data-cik><Ikon ad={kayit.dal.ikon} boy={18} />{kayit.dal.ad}</a>
    </nav>
  </div>
  <div class="oda-baslik sar">
    <div class="konusma">
      <h1>{kayit.baslik}</h1>
      <p>{kayit.ozet}</p>
      <slot />
    </div>
  </div>
</header>

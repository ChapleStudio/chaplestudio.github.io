---
import Ikon from './Ikon.astro';
import Kart from './Kart.astro';
import type { Dugum, Yer } from '../kutuphane/agac';
interface Props { dugum: Dugum; yerler: Map<string, Yer> }
const { dugum, yerler } = Astro.props;
const y = yerler.get(dugum.id);
const yer = y && [y.x, y.y, y.w, y.h].map(Math.round).join(' ');
const sayi = (d: Dugum): number => (d.tur === 'kayit' ? 1 : d.cocuklar.reduce((t, c) => t + sayi(c), 0));
---
<li data-tur={dugum.tur} data-renk={dugum.renk} id={dugum.id}>
  {dugum.tur === 'kayit' ? (
    <Kart kayit={dugum.kayit!} dugum={dugum.id} {...yer ? { yer } : {}} />
  ) : (
    <Fragment>
      <a href={`#${dugum.id}`} class:list={['dugum', 'dal', dugum.ikon === 'alt' && 'alt-dal']} data-dal data-dugum={dugum.id} data-renk={dugum.renk} data-yer={yer}><Ikon ad={dugum.ikon} boy={24} /><span>{dugum.ad}</span><span class="sayi">{sayi(dugum)}</span></a>
      <ul role="list">{dugum.cocuklar.map((c) => <Astro.self dugum={c} yerler={yerler} />)}</ul>
    </Fragment>
  )}
</li>

---
import Ikon from './Ikon.astro';
import { ayYilYaz, type Kayit } from '../kutuphane/kayit';
interface Props { kayitlar: Kayit[]; ad: string }
const { kayitlar, ad } = Astro.props;
const ilk = kayitlar[0];
---
<div class="raf-alani">
  <ul class="raf" role="list" aria-label={ad}>
    {kayitlar.map((k) => (
      <li>
        <a href={k.yol} class="kutu" data-kutu={k.yol} data-renk={k.renk} data-ikon={k.ikon} data-kapsam={k.kapsam} data-baslik={k.baslik} data-ozet={k.ozet} data-bilgi={`${k.turAdi}, ${ayYilYaz(k.tarih)}`}>
          <span class="isaret"><Ikon ad={k.ikon} boy={22} /></span>
          <span class="sirt">{k.sirtAdi}</span>
          <span class="gizli">, {k.turAdi}, </span>
          <span class="yil">{k.tarih.getUTCFullYear()}</span>
        </a>
      </li>
    ))}
  </ul>
  {ilk && (
    <div class="etiket" aria-hidden="true">
      <p class="etiket-ad" data-etiket="baslik">{ilk.baslik}</p>
      <p data-etiket="ozet">{ilk.ozet}</p>
      <p class="etiket-bilgi" data-etiket="bilgi">{ilk.turAdi}, {ayYilYaz(ilk.tarih)}</p>
    </div>
  )}
</div>
<script>
  for (const alan of document.querySelectorAll<HTMLElement>('.raf-alani')) {
    const goster = (hedef: EventTarget | null) => {
      const kutu = hedef instanceof Element ? hedef.closest<HTMLElement>('.kutu') : null;
      if (!kutu) return;
      for (const alanAdi of ['baslik', 'ozet', 'bilgi'] as const) {
        const yer = alan.querySelector(`[data-etiket="${alanAdi}"]`);
        if (yer) yer.textContent = kutu.dataset[alanAdi] ?? '';
      }
    };
    alan.addEventListener('pointerover', (e) => goster(e.target));
    alan.addEventListener('focusin', (e) => goster(e.target));
  }
</script>
<style>
  .kutu { background: var(--kutu); color: var(--kutu-yazi); text-decoration: none; display: flex; align-items: center; border-radius: 2px; }
  .isaret { display: inline-flex; }
  .sirt { font: 800 var(--sirt, 1.75rem)/1 var(--baslik); white-space: nowrap; }
  .yil { font: 600 0.9375rem/1 var(--baslik); letter-spacing: 0.02em; font-variant-numeric: tabular-nums; }
  .etiket { display: grid; grid-template-columns: minmax(0, 18rem) minmax(0, 1fr) auto; gap: 0.25rem 2rem; align-items: baseline; padding-top: 1rem; min-height: 4.5rem; }
  .etiket-ad { font: 800 1.75rem/1 var(--baslik); }
  .etiket-bilgi { color: var(--soluk); }

  @media (min-width: 48rem) {
    .raf { --satir: 27rem; --kalinlik: 0.75rem; display: flex; flex-wrap: wrap; gap: 0 3px;
      background: repeating-linear-gradient(to bottom, transparent 0 calc(var(--satir) - var(--kalinlik)), var(--tahta) calc(var(--satir) - var(--kalinlik)) var(--satir)); }
    .raf li { height: var(--satir); padding-bottom: var(--kalinlik); display: flex; align-items: flex-end; }
    .kutu { writing-mode: vertical-rl; rotate: 180deg; justify-content: space-between; gap: 0.75rem; padding: 1rem 0; width: var(--en); height: var(--boy); transition: translate 260ms var(--cikis); }
    .kutu .isaret { rotate: 180deg; order: 3; }
    .kutu .sirt { flex: 1; }
    .kutu .yil { order: 0; writing-mode: horizontal-tb; rotate: 180deg; }
    .kutu .sirt { order: 1; }
    .kutu[data-kapsam='1'] { --en: 3.25rem; --sirt: 1.8rem; }
    .kutu[data-kapsam='2'] { --en: 4.5rem; --sirt: 2.6rem; }
    .kutu[data-kapsam='3'] { --en: 6rem; --sirt: 3.7rem; }
    .kutu[data-kapsam='4'] { --en: 8.5rem; --sirt: 4.9rem; }
    .kutu[data-ikon='motor'] { --boy: 25rem; }
    .kutu[data-ikon='masaustu'] { --boy: 23rem; }
    .kutu[data-ikon='oyun'] { --boy: 20.5rem; }
    .kutu[data-ikon='mobil'] { --boy: 18rem; }
    .kutu[data-ikon='yazi'] { --boy: 21.5rem; }
    .kutu:is(:hover, :focus-visible) { translate: 0 -0.9rem; }
    .raf li:last-child:not(:first-child) { margin-left: 1.65rem; transform-origin: left calc(100% - var(--kalinlik)); transform: rotate(-4deg); }
  }
  @media (max-width: 47.99rem) {
    .raf { display: grid; gap: 3px; border-bottom: 0.75rem solid var(--tahta); }
    .kutu { gap: 0.75rem; padding: 0.55rem 0.9rem; min-height: 3rem; }
    .kutu .sirt { flex: 1; min-width: 0; white-space: normal; }
    .kutu[data-kapsam='1'] { --sirt: 1.6rem; margin-right: 18%; }
    .kutu[data-kapsam='2'] { --sirt: 2rem; margin-right: 10%; }
    .kutu[data-kapsam='3'] { --sirt: 2.5rem; margin-right: 4%; }
    .kutu[data-kapsam='4'] { --sirt: 3.2rem; }
    .etiket { display: none; }
  }
</style>

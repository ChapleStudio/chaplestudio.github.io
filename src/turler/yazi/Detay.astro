---
import { render } from 'astro:content';
import { isoGun, tarihYaz, type YaziKaydi } from '../../kutuphane/kayit';
interface Props { kayit: YaziKaydi }
const { kayit } = Astro.props;
const { Content } = await render(kayit.girdi);
---
<div class="govde">
  <h1 class="proje-adi">{kayit.baslik}</h1>
  <p class="giris">{kayit.ozet}</p>
  <p><time datetime={isoGun(kayit.veri.tarih)}>{tarihYaz(kayit.veri.tarih)}</time>{kayit.veri.guncelleme && <>, güncelleme <time datetime={isoGun(kayit.veri.guncelleme)}>{tarihYaz(kayit.veri.guncelleme)}</time></>}</p>
  <div class="yazi"><Content /></div>
</div>

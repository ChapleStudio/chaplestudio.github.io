---
import { render } from 'astro:content';
import Etiketler from '../../bilesenler/Etiketler.astro';
import OdaGiris from '../../bilesenler/OdaGiris.astro';
import { isoGun, tarihYaz, type YaziKaydi } from '../../kutuphane/kayit';
interface Props { kayit: YaziKaydi }
const { kayit } = Astro.props;
const { Content } = await render(kayit.girdi);
---
<OdaGiris kayit={kayit} />
<div class="sar oda-govde" data-renk={kayit.dal.renk}>
  <dl class="kunye">
    <div><dt>Tarih</dt><dd><time datetime={isoGun(kayit.veri.tarih)}>{tarihYaz(kayit.veri.tarih)}</time></dd></div>
    {kayit.veri.guncelleme && <div><dt>Güncelleme</dt><dd><time datetime={isoGun(kayit.veri.guncelleme)}>{tarihYaz(kayit.veri.guncelleme)}</time></dd></div>}
    {kayit.etiketler.length > 0 && <div><dt>Etiketler</dt><dd><Etiketler etiketler={kayit.etiketler} /></dd></div>}
  </dl>
  <div class="yazi"><Content /></div>
</div>

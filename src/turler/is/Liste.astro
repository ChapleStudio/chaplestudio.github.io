---
import { kumele, type IsKaydi } from '../../kutuphane/kayit';
interface Props { kayitlar: IsKaydi[] }
const { kayitlar } = Astro.props;
---
<form class="ara" data-ara hidden role="search">
  <label for="ara">Ara</label>
  <input id="ara" type="search" name="ara" autocomplete="off" />
  <p role="status" data-sayi>{kayitlar.length} iş</p>
</form>
<div data-liste>
  {kumele(kayitlar).map((c) => (
    <section data-kume>
      <h2>{c.ad}</h2>
      <ul role="list">
        {c.kayitlar.map((k) => (
          <li data-metin={[k.baslik, k.ozet, k.veri.kisa, c.ad, ...k.etiketler.map((e) => e.ad)].join(' ')}>
            <h3><a href={k.yol}>{k.baslik}</a></h3>
            <p>{k.ozet}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
<p data-bos hidden>Buna uyan iş yok. <button type="button" data-temizle>Aramayı temizle</button></p>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-ara]');
  const alan = form?.querySelector('input');
  if (form && alan) {
    const satirlar = [...document.querySelectorAll<HTMLElement>('[data-metin]')];
    const sayi = form.querySelector('[data-sayi]');
    const bos = document.querySelector<HTMLElement>('[data-bos]');
    /** Türkçe harf ve aksan duyarsız arama: "gorsel" yazan "görsel"i bulur. */
    const sade = (m: string) => m.toLocaleLowerCase('tr').normalize('NFD').replace(/\p{M}/gu, '').replaceAll('ı', 'i');
    const metinler = new Map(satirlar.map((s) => [s, sade(s.dataset['metin'] ?? '')]));
    const suz = (adresiYaz: boolean) => {
      const sozcukler = sade(alan.value).split(/\s+/).filter(Boolean);
      for (const s of satirlar) s.hidden = !sozcukler.every((p) => metinler.get(s)!.includes(p));
      for (const k of document.querySelectorAll<HTMLElement>('[data-kume]')) k.hidden = !k.querySelector('li:not([hidden])');
      const kalan = satirlar.filter((s) => !s.hidden).length;
      if (sayi) sayi.textContent = `${kalan} iş`;
      if (bos) bos.hidden = kalan > 0;
      if (adresiYaz) history.replaceState(null, '', alan.value.trim() ? `?${new URLSearchParams({ ara: alan.value.trim() })}` : location.pathname);
    };
    form.hidden = false;
    alan.value = new URLSearchParams(location.search).get('ara') ?? '';
    form.addEventListener('input', () => suz(true));
    form.addEventListener('submit', (e) => e.preventDefault());
    document.querySelector('[data-temizle]')?.addEventListener('click', () => { alan.value = ''; suz(true); alan.focus(); });
    suz(false);
  }
</script>
<style>
  .ara { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; margin-bottom: 1rem; }
  .ara label { font-weight: 700; }
  .ara input { flex: 0 1 26rem; min-width: 0; min-height: 3rem; padding: 0 1rem; border: 2px solid #111; border-radius: 0; background: #fff; }
  .ara p { color: var(--soluk); font-variant-numeric: tabular-nums; }
  section { padding-top: 3rem; }
  h2 { font-size: 2.125rem; font-weight: 800; margin-bottom: 0.75rem; }
  ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(22rem, 100%), 1fr)); gap: 1.75rem 3rem; }
  h3 { font-size: 1.375rem; font-weight: 700; margin-bottom: 0.3rem; letter-spacing: -0.01em; }
  h3 a { display: inline-flex; min-height: 1.75rem; align-items: center; }
  li p { color: var(--soluk); }
  button { font-weight: 700; text-decoration: underline; min-height: 2.75rem; }
</style>

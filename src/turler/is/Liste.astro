---
import Ikon from '../../bilesenler/Ikon.astro';
import { etiketGruplari, type Etiket, type EtiketGrubu } from '../../etiketler';
import { ayYilYaz, isoGun, type IsKaydi } from '../../kutuphane/kayit';
import { kategoriler, kategoriKimlikleri } from './kategoriler';
interface Props { kayitlar: IsKaydi[] }
const { kayitlar } = Astro.props;
const doluKategoriler = kategoriKimlikleri.filter((c) => kayitlar.some((k) => k.veri.kategori === c));
const hepsi = new Map<string, Etiket>(kayitlar.flatMap((k) => k.etiketler.map((e) => [e.id, e] as const)));
const gruplar = (Object.keys(etiketGruplari) as EtiketGrubu[]).map((g) => ({ ad: etiketGruplari[g].ad, etiketler: [...hepsi.values()].filter((e) => e.grup === g).sort((a, b) => a.ad.localeCompare(b.ad, 'tr')) })).filter((g) => g.etiketler.length);
const durum = (k: IsKaydi) =>
  k.suruyor ? 'Üzerinde çalışıyorum' : k.veri.baglantilar.some((b) => b.tur === 'indir' || b.tur === 'oyna') ? 'İndirilebilir' : 'Kaynak kodu açık';
---
<form class="suzgec" data-suzgec hidden role="search" aria-label="İşleri süz">
  <label class="ara"><span>Ara</span><span class="alan"><Ikon ad="ara" /><input type="search" name="ara" autocomplete="off" placeholder="unity, rust, çevrimiçi" /></span></label>
  <label><span>Kategori</span><select name="kategori"><option value="">Hepsi</option>{doluKategoriler.map((c) => <option value={c}>{kategoriler[c].ad}</option>)}</select></label>
  <label><span>Etiket</span><select name="etiket"><option value="">Hepsi</option>{gruplar.map((g) => <optgroup label={g.ad}>{g.etiketler.map((e) => <option value={e.id}>{e.ad}</option>)}</optgroup>)}</select></label>
  <p class="sayi" role="status" data-sayi>{kayitlar.length} iş</p>
</form>
<ul class="liste" role="list" data-liste>
  {kayitlar.map((k) => (
    <li data-kategori={k.veri.kategori} data-etiketler={k.etiketler.map((e) => e.id).join(' ')} data-metin={[k.baslik, k.ozet, k.dal.ad, k.altDal?.ad ?? '', ...k.etiketler.map((e) => e.ad)].join(' ')}>
      <span class="renk" data-renk={k.dal.renk}><Ikon ad={k.dal.ikon} boy={22} /></span>
      <div class="ana">
        <h2><a href={k.yol}>{k.baslik}</a></h2>
        <p>{k.ozet}</p>
        <p class="etiketcik">{k.vitrin.map((e) => <span>{e.ad}</span>)}</p>
      </div>
      <p class="yan">{k.dal.ad}{k.altDal && <><br />{k.altDal.ad}</>}</p>
      <p class="yan">{durum(k)}<br /><time datetime={isoGun(k.tarih)}>{ayYilYaz(k.tarih)}</time></p>
    </li>
  ))}
</ul>
<p class="bos" data-bos hidden>Bu süzgece uyan iş yok. <button type="button" data-temizle>Süzgeci temizle</button></p>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-suzgec]');
  const liste = document.querySelector('[data-liste]');
  if (form && liste) {
    const satirlar = [...liste.querySelectorAll<HTMLElement>('li')];
    const sayi = form.querySelector('[data-sayi]');
    const bos = document.querySelector<HTMLElement>('[data-bos]');
    /** Türkçe harf ve aksan duyarsız arama: "gorsel" yazan "görsel"i bulur. */
    const sade = (m: string) => m.toLocaleLowerCase('tr').normalize('NFD').replace(/\p{M}/gu, '').replaceAll('ı', 'i');
    const alanlar = ['ara', 'kategori', 'etiket'] as const;
    const metinler = new Map(satirlar.map((s) => [s, sade(s.dataset.metin ?? '')]));
    const deger = (ad: string) => String(new FormData(form).get(ad) ?? '').trim();

    const suz = (adresiYaz: boolean) => {
      const sozcukler = sade(deger('ara')).split(/\s+/).filter(Boolean);
      const kategori = deger('kategori');
      const etiket = deger('etiket');
      let kalan = 0;
      for (const s of satirlar) {
        const uyar =
          (!kategori || s.dataset['kategori'] === kategori) &&
          (!etiket || (s.dataset['etiketler'] ?? '').split(' ').includes(etiket)) &&
          sozcukler.every((p) => metinler.get(s)!.includes(p));
        s.hidden = !uyar;
        if (uyar) kalan++;
      }
      if (sayi) sayi.textContent = `${kalan} iş`;
      if (bos) bos.hidden = kalan > 0;
      if (adresiYaz) {
        const p = new URLSearchParams();
        for (const a of alanlar) if (deger(a)) p.set(a, deger(a));
        history.replaceState(null, '', p.size ? `?${p}` : location.pathname);
      }
    };
    const adrestenOku = () => {
      const p = new URLSearchParams(location.search);
      for (const a of alanlar) {
        const alan = form.elements.namedItem(a);
        if (alan instanceof HTMLInputElement) alan.value = p.get(a) ?? '';
        if (alan instanceof HTMLSelectElement) {
          alan.value = p.get(a) ?? '';
          if (alan.selectedIndex < 0) alan.value = '';
        }
      }
      suz(false);
    };
    form.hidden = false;
    form.addEventListener('input', () => suz(true));
    form.addEventListener('submit', (e) => e.preventDefault());
    document.querySelector('[data-temizle]')?.addEventListener('click', () => {
      form.reset();
      for (const a of alanlar) {
        const alan = form.elements.namedItem(a);
        if (alan instanceof HTMLInputElement || alan instanceof HTMLSelectElement) alan.value = '';
      }
      suz(true);
      form.querySelector('input')?.focus();
    });
    addEventListener('popstate', adrestenOku);
    adrestenOku();
  }
</script>
<style>
  .suzgec { display: grid; gap: 1rem; align-items: end; margin-bottom: 2.5rem; }
  .suzgec[hidden] { display: none; }
  .suzgec label { display: grid; gap: 0.4rem; min-width: 0; color: var(--soluk); }
  .alan, select { background: var(--yuzey); border: 1.5px solid #8d867c; border-radius: 99px; min-height: 3rem; min-width: 0; color: var(--kemik); }
  .alan { display: flex; align-items: center; gap: 0.6rem; padding-left: 1.1rem; }
  .alan input { flex: 1; min-width: 0; border: 0; background: none; height: 2.8rem; padding: 0 1rem 0 0; outline: none; caret-color: var(--mercan); }
  .alan:focus-within { outline: 2px solid var(--kemik); outline-offset: 3px; }
  input::placeholder { color: var(--soluk); opacity: 1; }
  select { padding: 0 1rem; width: 100%; }
  .sayi { font-variant-numeric: tabular-nums; padding-bottom: 0.75rem; color: var(--soluk); }
  .liste li { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 0.4rem 1.2rem; padding-block: 1.35rem; border-top: 1.5px solid var(--cizgi); position: relative; }
  .liste li[hidden] { display: none; }
  .renk { grid-row: 1 / span 3; color: var(--dal); display: grid; place-items: center; width: 3rem; height: 3rem; border: 1.5px solid var(--dal); border-radius: 14px; }
  .ana h2 { font-size: 1.5rem; margin-bottom: 0.35rem; }
  .ana h2 a { text-decoration: none; }
  .ana h2 a::after { content: ''; position: absolute; inset: 0; }
  .liste li:hover h2 a { text-decoration: underline; }
  .yan { color: var(--soluk); font-size: 1rem; line-height: 1.5; }
  .bos { padding-block: 2rem; font-size: 1.1875rem; }
  .bos button { border: 0; background: none; padding: 0.4rem 0; font-weight: 600; text-decoration: underline; cursor: pointer; }
  @media (min-width: 40rem) { .suzgec { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr) 4.5rem; } }
  @media (min-width: 60rem) { .liste li { grid-template-columns: 3rem minmax(0, 1fr) 14rem 12rem; gap: 0 2rem; } .renk { grid-row: auto; } }
</style>

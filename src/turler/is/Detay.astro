---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Afis from '../../bilesenler/Afis.astro';
import { gruptakiler } from '../../etiketler';
import { ayYilYaz, type IsKaydi } from '../../kutuphane/kayit';
interface Props { kayit: IsKaydi }
const { kayit } = Astro.props;
const v = kayit.veri;
const { Content } = await render(kayit.girdi);
const adlar = (g: Parameters<typeof gruptakiler>[1]) => gruptakiler(kayit.etiketler, g).map((e) => e.ad).join(', ');
const [ilk, son] = [ayYilYaz(v.baslangic), ayYilYaz(v.guncelleme)];
const bilgi = [
  ['Türü', adlar('tur')],
  ['Araç', adlar('arac')],
  ['Dil', adlar('dil')],
  ['Platform', adlar('platform')],
  ['Lisans', v.lisans ?? ''],
  v.suruyor ? ['Sürüyor', `${ilk} tarihinden beri`] : ['Yapıldı', ilk === son ? ilk : `${ilk} – ${son}`],
].filter(([, d]) => d);
---
<div class="kafa">
  <Afis kayit={kayit} hemen />
  <a class="geri" href={`/#isler/${kayit.id}`} data-cik={kayit.id}><svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M19 7H2M8 1L2 7l6 6"></path></svg>Bütün projeler</a>
</div>
<div class="govde">
  <h1 class="proje-adi">{kayit.baslik}</h1>
  <p class="giris">{kayit.ozet}</p>
  <div class="kunye">
    {v.baglantilar.length > 0 && <ul class="eylem" role="list">{v.baglantilar.map((b) => <li><a href={b.adres} rel="noopener"><span>{b.ad}</span><span>{b.not ?? (b.tur === 'kaynak' ? 'GitHub' : '')}</span></a></li>)}</ul>}
    <dl class="bilgi">{bilgi.map(([ad, deger]) => <><dt>{ad}</dt><dd>{deger}</dd></>)}</dl>
  </div>
  <div class="yazi"><Content /></div>
  {v.serit && (
    <section class="serit" aria-label="Nasıl çalışıyor">
      <Image src={v.serit.gorsel} alt={v.serit.alt} layout="none" widths={[640, 1200, 1920]} sizes="(min-width: 1260px) 1180px, 92vw" quality={84} loading="lazy" />
      <div class="adimlar">{v.serit.adimlar.map((a) => <div><h2>{a.ad}</h2><p>{a.metin}</p></div>)}</div>
    </section>
  )}
  {v.gorseller.length > 0 && (
    <div class="galeri">
      {v.gorseller.map((g, i) => (
        <figure>
          <Image src={g.dosya} alt={g.alt} layout="none" widths={[480, 800, 1200, 1600]} sizes={i === 0 ? '(min-width: 1260px) 1180px, 92vw' : '(min-width: 861px) 580px, 92vw'} loading="lazy" />
          {g.altyazi && <figcaption>{g.altyazi}</figcaption>}
        </figure>
      ))}
    </div>
  )}
</div>

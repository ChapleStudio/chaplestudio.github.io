---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Ikon from '../../bilesenler/Ikon.astro';
import OdaGiris from '../../bilesenler/OdaGiris.astro';
import { ayYilYaz, isoGun, type IsKaydi } from '../../kutuphane/kayit';
interface Props { kayit: IsKaydi }
const { kayit } = Astro.props;
const v = kayit.veri;
const { Content } = await render(kayit.girdi);
const [kapak, ...digerleri] = v.gorseller;
---
<OdaGiris kayit={kayit}>
  {v.baglantilar.length > 0 && (
    <ul class="eylem" role="list">
      {v.baglantilar.map((b, i) => (
        <li><a class:list={['dugme', i === 0 && 'asil']} href={b.adres} rel="noopener"><Ikon ad={b.tur} /><span>{b.ad}{b.not && ` (${b.not})`}</span></a></li>
      ))}
    </ul>
  )}
</OdaGiris>
<div class="sar oda-govde" data-renk={kayit.dal.renk}>
  <dl class="kunye">
    <div><dt>Çeşit</dt><dd>{kayit.turAdi}</dd></div>
    <div><dt>Platform</dt><dd>{v.platform.join(', ')}</dd></div>
    <div><dt>Teknoloji</dt><dd>{v.teknoloji.join(', ')}</dd></div>
    <div><dt>GitHub'da ilk kayıt</dt><dd><time datetime={isoGun(v.baslangic)}>{ayYilYaz(v.baslangic)}</time></dd></div>
    <div><dt>Son güncelleme</dt><dd><time datetime={isoGun(v.guncelleme)}>{ayYilYaz(v.guncelleme)}</time></dd></div>
    {v.lisans && <div><dt>Lisans</dt><dd>{v.lisans}</dd></div>}
    {v.suruyor && <div><dt>Durum</dt><dd>Üzerinde çalışıyorum</dd></div>}
  </dl>
  <div>
    {kapak && (
      <figure>
        <Image src={kapak.dosya} alt={kapak.alt} widths={[480, 800, 1200, 1600]} sizes="(min-width: 64rem) 58vw, 92vw" loading="lazy" />
        {kapak.altyazi && <figcaption>{kapak.altyazi}</figcaption>}
      </figure>
    )}
    <div class="yazi"><Content /></div>
    {digerleri.length > 0 && (
      <div class="galeri">
        {digerleri.map((g) => (
          <figure>
            <Image src={g.dosya} alt={g.alt} widths={[480, 800, 1200]} sizes="(min-width: 64rem) 29vw, 92vw" />
            {g.altyazi && <figcaption>{g.altyazi}</figcaption>}
          </figure>
        ))}
      </div>
    )}
  </div>
</div>

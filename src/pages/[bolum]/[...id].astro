---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import Sayfa from '../../duzen/Sayfa.astro';
import Kart from '../../bilesenler/Kart.astro';
import IsDetay from '../../turler/is/Detay.astro';
import YaziDetay from '../../turler/yazi/Detay.astro';
import { acikBolumler } from '../../site';
import { bolumKayitlari } from '../../kutuphane/kayit';
export const getStaticPaths = (async () => {
  const bolumler = await Promise.all(acikBolumler.map(bolumKayitlari));
  return bolumler.flatMap((kayitlar) =>
    kayitlar.map((kayit) => ({
      params: { bolum: kayit.bolum.id, id: kayit.id },
      props: { kayit, komsular: kayitlar.filter((k) => k.dal.id === kayit.dal.id && k.id !== kayit.id).slice(0, 4) },
    })),
  );
}) satisfies GetStaticPaths;
const { kayit, komsular } = Astro.props;
const kapak = kayit.tur === 'is' ? kayit.veri.gorseller[0] : undefined;
const gorsel = kapak && (await getImage({ src: kapak.dosya, width: 1200, format: 'jpeg', layout: 'none' })).src;
---
<Sayfa baslik={kayit.baslik} aciklama={kayit.ozet} tur="article" ust={false} {...gorsel ? { gorsel } : {}}>
  <article class="oda">
    {kayit.tur === 'is' ? <IsDetay kayit={kayit} /> : <YaziDetay kayit={kayit} />}
    {komsular.length > 0 && (
      <section class="sar komsular" aria-labelledby="komsu">
        <h2 id="komsu">Aynı daldan</h2>
        <ul role="list">{komsular.map((k) => <li><Kart kayit={k} /></li>)}</ul>
      </section>
    )}
  </article>
</Sayfa>
<script>
  import '../../tuval/sahnelik';
</script>

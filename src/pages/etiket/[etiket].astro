---
import type { GetStaticPaths } from 'astro';
import Sayfa from '../../duzen/Sayfa.astro';
import Kart from '../../bilesenler/Kart.astro';
import Ikon from '../../bilesenler/Ikon.astro';
import { etiketGruplari } from '../../etiketler';
import { etiketDizini } from '../../kutuphane/etiket-dizini';
export const getStaticPaths = (async () => (await etiketDizini()).map((s) => ({ params: { etiket: s.etiket.id }, props: { etiket: s.etiket, kayitlar: s.kayitlar } }))) satisfies GetStaticPaths;
const { etiket, kayitlar } = Astro.props;
---
<Sayfa baslik={etiket.ad} aciklama={`${etiket.ad} etiketli ${kayitlar.length} kayıt`}>
  <div class="sar sayfa-ic">
    <h1>{etiket.ad}</h1>
    <p class="alt-bilgi">{`${etiketGruplari[etiket.grup].ad}, ${kayitlar.length} kayıt`}</p>
    <p class="eylem"><a class="dugme" href={`/?etiket=${etiket.id}`}><Ikon ad="agac" />Ağaçta göster</a><a class="dugme" href="/etiket/"><Ikon ad="etiket" />Bütün etiketler</a></p>
    <h2 class="gizli">Kayıtlar</h2>
    <ul class="izgara" role="list">{kayitlar.map((k) => <li><Kart kayit={k} /></li>)}</ul>
  </div>
</Sayfa>
<script>
  import '../../tuval/sahnelik';
</script>
<style>
  .alt-bilgi { color: var(--soluk); margin-top: 1rem; }
  .izgara { display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr)); margin-top: 3rem; }
</style>

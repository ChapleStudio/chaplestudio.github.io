---
import Sayfa from '../duzen/Sayfa.astro';
import Dal from '../bilesenler/Dal.astro';
import Ikon from '../bilesenler/Ikon.astro';
import { acikBolumler, site } from '../site';
import { agacKur, yerlestir, type Dugum } from '../kutuphane/agac';

const kok = await agacKur();
const { yerler, cizgiler } = yerlestir(kok);
const ebeveyn: Record<string, string> = {};
const gez = (d: Dugum) => d.cocuklar.forEach((c) => { ebeveyn[c.id] = d.id; gez(c); });
gez(kok);
const k = yerler.get('kok')!;
const dallar = kok.cocuklar;
---
<Sayfa ust={false}>
  <header class="ust-kapsul">
    <nav class="kapsul" aria-label="Dallar">
      <a href="#kok" data-dal data-dugum-git="kok" aria-current="true">Hepsi</a>
      {dallar.map((d) => <a href={`#${d.id}`} data-dal data-dugum-git={d.id} data-renk={d.renk}><Ikon ad={d.ikon} boy={18} />{d.ad}</a>)}
    </nav>
  </header>
  <div class="tuval" data-tuval>
    <canvas class="zemin" aria-hidden="true"></canvas>
    <div class="dunya">
      <div class="dugum kok" id="kok" data-dugum="kok" data-yer={[k.x, k.y, k.w, k.h].map(Math.round).join(' ')}>
        <h1>{site.ad}</h1>
        <p>{site.aciklama}</p>
      </div>
      <ul role="list" aria-label="Proje ağacı">{dallar.map((d) => <Dal dugum={d} yerler={yerler} />)}</ul>
    </div>
  </div>
  <p class="ipucu" aria-hidden="true">Sürükle, tekerlekle yaklaş, bir dala ya da projeye tıkla</p>
  <div class="araclar">
    <div class="kapsul" role="group" aria-label="Görünüm">
      <button type="button" data-yakin="1.35"><Ikon ad="arti" /><span class="gizli">Yaklaş</span></button>
      <button type="button" data-yakin="0.74"><Ikon ad="eksi" /><span class="gizli">Uzaklaş</span></button>
      {acikBolumler.map((b) => <a href={`/${b.id}/`}><Ikon ad="ara" /><span>{acikBolumler.length > 1 ? b.ad : 'Liste'}</span></a>)}
    </div>
  </div>
  <script type="application/json" id="agac" is:inline set:html={JSON.stringify({ cizgiler, ebeveyn }).replaceAll('<', '\\u003c')} />
  <div class="oda-kabi" hidden slot="son" data-oda-kabi></div>
</Sayfa>
<script>
  import '../tuval/tuval';
</script>

---
import Sayfa from '../duzen/Sayfa.astro';
import Afis from '../bilesenler/Afis.astro';
import { acikBolumler, site } from '../site';
import { kumele, tumIsler } from '../kutuphane/kayit';
import '../stil/sahne.css';

const isler = await tumIsler();
const ilk = isler.find((k) => k.id === site.vitrin) ?? isler[0];
if (!ilk) throw new Error('Ana sayfada gösterilecek iş yok');
const kumeler = kumele(isler);
/** Blog gibi iş olmayan bölümler büyük kelimelerin sonuna bağlantı olarak eklenir. */
const digerBolumler = acikBolumler.filter((b) => b.tur !== 'is');
---
<Sayfa ust={false}>
  <div class="kok" data-kok>
    <section class="sahne" data-sahne data-is={ilk.id} aria-label="Seçili proje">
      <div class="afisler" aria-hidden="true">
        {isler.map((k) => <div class:list={['afis', k === ilk && 'secili']} id={`isler/${k.id}`} data-afis={k.id} data-is={k.id} hidden={k !== ilk}><Afis kayit={k} hemen={k === ilk} /></div>)}
      </div>
      <header class="bas"><h1><a class="marka" href="/">{site.ad}</a></h1></header>
      <div class="sozler" aria-live="polite">
        {isler.map((k) => (
          <div class="soz" data-soz={k.id} data-is={k.id} hidden={k !== ilk}>
            <h2 class="proje-adi">{k.baslik}</h2>
            <p>{k.ozet}</p>
            <p><a class="dugme" href={k.yol} data-gir={k.id}>İçine gir<span class="gizli">: {k.baslik}</span></a></p>
          </div>
        ))}
      </div>
      {kumeler.map((c) => (
        <div class="dilimler" data-dilimler={c.id} hidden>
          {c.kayitlar.map((k) => <a class="dilim" href={k.yol} data-dilim={k.id} data-is={k.id}><Afis kayit={k} /><b>{k.baslik}</b></a>)}
        </div>
      ))}
    </section>
    <section class="plaka" data-plaka aria-label="Bütün projeler">
      <div class="raf">
        {kumeler.map((c) => (
          <div class:list={['grup', c.id === ilk.kume.id && 'acik']} data-grup={c.id}>
            <h2><button type="button" data-kategori={c.id} aria-expanded="false">{c.ad}</button></h2>
            <ul class="liste" role="list">
              {c.kayitlar.map((k) => <li><a class="ad" href={k.yol} data-sec={k.id} aria-current={k === ilk ? 'true' : undefined}><span>{k.baslik}</span><i>{k.veri.kisa}</i></a></li>)}
            </ul>
          </div>
        ))}
        {digerBolumler.map((b) => <div class="grup"><h2><a href={`/${b.id}/`}>{b.ad}</a></h2></div>)}
      </div>
    </section>
  </div>
  <script is:inline src="/ilk.js" slot="bas"></script>
</Sayfa>
<script>
  import '../sahne/sahne';
</script>
